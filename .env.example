# Copy this file to `.env.local` and fill in values. Never commit `.env.local`.

# Optional. The site's own origin — used to lock the API routes' CORS. If unset,
# the deployment's own URL is used (works for prod + preview automatically).
# NEXT_PUBLIC_SITE_URL=https://street-vibe.vercel.app

# Preferred translation model: direct Generative Language API (fast + cheap).
# Get a key at https://aistudio.google.com/apikey — this is NOT the same as a
# Google Cloud key scoped to Text-to-Speech. Optional: without it, translation
# falls back to the Replicate-hosted model below.
GEMINI_TEXT_API_KEY=
# Optional overrides (defaults: model gemini-3.6-flash, thinking budget 256)
# GEMINI_TEXT_MODEL=gemini-3.6-flash
# GEMINI_THINKING_BUDGET=256

# Fallback translation model + MiniMax voice (`/api/tts`, `/api/tts-poll`).
REPLICATE_API_TOKEN=

# Most natural voice. When set, `/api/tts` uses ElevenLabs and only falls back
# to MiniMax on error. Free key at https://elevenlabs.io (10k chars/mo).
ELEVENLABS_API_KEY=
# Optional. Default eleven_v3_conversational (expressive + fast, 74 langs).
# eleven_multilingual_v2 = steadier on very short lines; eleven_flash_v2_5 = half price.
# ELEVENLABS_MODEL_ID=eleven_v3_conversational
# Voice ids from your ElevenLabs library (defaults: Will / Jessica).
# ELEVENLABS_VOICE_MALE=
# ELEVENLABS_VOICE_FEMALE=

# Accounts (optional). With both set, a "Sign in" button appears and the app
# can meter usage per user. Without them the app runs fully anonymous.
# Keys from https://dashboard.clerk.com → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Usage metering (optional). Without these the daily caps are disabled and every
# request is allowed. Create a project at https://supabase.com, run
# supabase/schema.sql in its SQL editor, then paste the Project URL and the
# service_role key (Settings → API). The service_role key is secret — server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: salt for the hashed-IP key used to meter anonymous visitors.
# USAGE_IP_SALT=

# Payments (optional) — Lemon Squeezy, a Merchant of Record (handles global
# sales tax / VAT). No API key needed — uses the no-code "buy link". Without
# these the "Upgrade to Pro" button is hidden and /api/billing/* return 503.
# From https://app.lemonsqueezy.com:
#  - LEMONSQUEEZY_CHECKOUT_URL: create a Product "Street Vibe Pro" (Subscription,
#    $7/month), Publish it, then Share → copy the buy link, e.g.
#    https://yourstore.lemonsqueezy.com/buy/1a2b3c4d-....
#  - LEMONSQUEEZY_WEBHOOK_SECRET: Settings → Webhooks → add callback
#    <site>/api/billing/webhook, sign it with a secret you choose, and tick
#    subscription_created / _updated / _expired (also _resumed / _unpaused).
#    Secret.
LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Optional. Defaults to <store origin>/billing (Lemon Squeezy's hosted portal).
# LEMONSQUEEZY_PORTAL_URL=
# Optional label shown on the upgrade button, e.g. "$7/mo".
# NEXT_PUBLIC_PRO_PRICE_LABEL=

# Legacy Google route remains in the codebase for development only.
