# Copy this file to `.env.local` and fill in values. Never commit `.env.local`.
# Required by `/api/translate`, `/api/tts` (MiniMax), and `/api/tts-poll`:
REPLICATE_API_TOKEN=
# Optional legacy Google Cloud TTS route only:
GEMINI_API_KEY=
# Required by `/api/tts-mistral` (Mistral Voxtral zero-shot voice from local reference clip):
MISTRAL_API_KEY=
